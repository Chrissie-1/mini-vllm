{
  "uid": "mini-vllm",
  "title": "Mini-vLLM",
  "tags": ["inference", "llm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "type": "row",
      "title": "Serving",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Request rate by outcome",
      "description": "Shed load (503) is separated from upstream errors, because they call for different responses: scale out vs. investigate.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(gateway_requests_total[1m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "End-to-end latency",
      "description": "Quantiles over the gateway histogram. p99 diverging from p50 under load points at queueing, not at the model.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(gateway_latency_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gateway_latency_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(gateway_latency_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Time to first token",
      "description": "What a streaming client waits before anything appears. Dominated by admission-window and queue time, not by generation.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(llm_time_to_first_token_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(llm_time_to_first_token_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(llm_queue_wait_seconds_bucket[5m])))",
          "legendFormat": "p99 queue wait",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Token throughput",
      "description": "Completion tokens per second across all workers.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "none", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(llm_tokens_generated_total[1m]))",
          "legendFormat": "tokens/s",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Batching and KV cache",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }
    },
    {
      "type": "timeseries",
      "title": "Mean batch occupancy",
      "description": "Rows advanced per forward pass. Sitting near 1 under load means batches are not forming and throughput is being left on the table.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(llm_batch_size_sum[1m])) / sum(rate(llm_batch_size_count[1m]))",
          "legendFormat": "mean batch",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "KV cache hit ratio",
      "description": "Fraction of attended positions served from cache rather than recomputed. Approaches 1 as sequences lengthen; a drop means prefills dominate.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 18 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(llm_kv_cache_reused_positions_total[5m])) / clamp_min(sum(rate(llm_kv_cache_attended_positions_total[5m])), 1)",
          "legendFormat": "hit ratio",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "KV cache memory",
      "description": "Resident cache size. Grows with batch size times sequence length; this is the axis that runs out first in production.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(llm_kv_cache_bytes)",
          "legendFormat": "cache bytes",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Scheduler and workers",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 }
    },
    {
      "type": "timeseries",
      "title": "Scheduler depth",
      "description": "Running vs. waiting. A persistently non-empty queue with a full batch is the signal to add workers.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        { "expr": "sum(llm_running_requests)", "legendFormat": "running", "refId": "A" },
        { "expr": "sum(llm_queued_requests)", "legendFormat": "queued", "refId": "B" },
        {
          "expr": "gateway_admission_slots_used",
          "legendFormat": "admission slots used",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Per-worker load",
      "description": "Least-in-flight routing should keep these lines close together. Sustained divergence means a worker is degraded.",
      "gridPos": { "h": 8, "w": 8, "x": 12, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "expr": "gateway_worker_inflight",
          "legendFormat": "{{worker}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Healthy workers",
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "green", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [{ "expr": "gateway_workers_healthy", "refId": "A" }]
    }
  ]
}
